@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Helvetica
node "Репозиторий" as repo {
  artifact "Бандлы\nartifacts/bundle" as bnd
  artifact "Календари 2024-2026\nи геометрия линий" as ref
}
node "Сборка образа, Docker" {
  node "Стадия 1: golang:1.24-bookworm" as s1 {
    component "libcatboostmodel" as lib
    component "Бинарник сервера (cgo)" as bin
  }
}
node "Прод-хост" as host {
  component "nginx\nhttps://mttech.k1rles.ru" as nginx
  component "Прежний стенд\nкопия для отката" as old
  node "Контейнер: debian:bookworm-slim, nobody" as run {
    component "Go-сервер\nтолько API" as srv
  }
}
actor "Клиент API" as cl
lib --> srv
bin --> srv
bnd --> srv
ref --> srv
cl --> nginx : HTTPS
nginx --> srv : 127.0.0.1:8090
@enduml

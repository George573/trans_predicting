@startuml
!pragma layout smetana
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Helvetica
actor "Диспетчер" as user
package "Бандлы, загружаются при старте" {
  artifact "Модели\nCatBoost и CNN" as m
  artifact "Калибровка\nмаршрут x день недели" as cal
  artifact "Коридор\nэмпирические квантили" as cor
  artifact "Постобработка\nмаршрут 5, Новый год" as pp
  artifact "Каталог условий\nс паспортами и кривыми" as cond
  artifact "Геометрия линий\nGeoJSON" as geo
}
package "Сервис, Go - реализован" {
  [Признаки и модель\nпо полю model] as model
  [Калибровка и постобработка] as post
  [Коридор и обычный уровень] as corr
  [Слой условий\nпроизведение, аудит] as layer
  [API по контракту OpenAPI 3.1\nPOST forecast, export CSV/XLSX,\nexplain, conditions, routes, geo] as api
}
[Дашборд\nReact + TypeScript,\nкарта Leaflet,\nсравнение моделей] as ui
m --> model
cal --> post
pp --> post
cor --> corr
cond --> layer
model --> post
post --> corr
corr --> layer
layer --> api
geo --> api
api --> ui
user --> ui
@enduml
